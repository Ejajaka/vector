{
  "name": "vector-mobile-rn",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File sync-engine.ps1",
    "start:device": "powershell -NoProfile -ExecutionPolicy Bypass -File start-device.ps1"
  },
  "dependencies": {
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  }
}

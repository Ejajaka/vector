{
  "name": "vector-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Vector - pre-generation security diagnosis for AWS prompts (Android + iOS via Capacitor)",
  "scripts": {
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File sync-engine.ps1",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "copy": "cap copy",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
